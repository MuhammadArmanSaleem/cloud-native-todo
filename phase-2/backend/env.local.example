# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Neon PostgreSQL Database Connection
# Format: postgresql+asyncpg://user:password@host/database
# Example: postgresql+asyncpg://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://user:password@host/database

# Better Auth Secret (for JWT token signing/verification)
# Generate a secure random string for production (e.g., use: openssl rand -hex 32)
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production

# API Configuration
API_URL=http://localhost:8000
